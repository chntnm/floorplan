{
  "name": "floorplan",
  "version": "0.1.0",
  "description": "Spatial planning for real rooms — import a floor plan, build an inventory, place it in 3D, and walk through it.",
  "author": "Chintan Mehta",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "node desktop/dev.mjs",
    "desktop:build": "pnpm run build && tsc --noEmit -p desktop && node desktop/build.mjs",
    "desktop:pack": "pnpm run desktop:build && electron-builder --dir",
    "desktop:dist": "pnpm run desktop:build && electron-builder",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "media": "playwright test --config playwright.media.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "konva": "^10.0.0",
    "node-html-parser": "^9.0.2",
    "pdfjs-dist": "^6.3.289",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
